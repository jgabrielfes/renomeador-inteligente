# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# Usada apenas no servidor, pela rota /api/rename — nunca chega ao navegador.
GEMINI_API_KEY=

# Senha de acesso da equipe: protege as rotas /api/* que chamam o Gemini.
# Com ela definida, o app pede a senha uma vez por navegador (cookie de sessão
# HttpOnly, 30 dias) e recusa chamadas anônimas com 401 — evita que scripts de
# terceiros consumam a cota/custo da API. Sem ela, a API fica aberta (dev).
APP_PASSWORD=

# Opcional: segredo que assina o cookie de sessão. Se ausente, é derivado da
# própria APP_PASSWORD (trocar a senha derruba as sessões antigas).
# Gere com: openssl rand -base64 32
# AUTH_SECRET=

# Opcional: endpoint alternativo (proxy/mock). Padrão: API oficial da Google.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Opcional: modelo principal. Padrão: gemini-flash-lite-latest, com
# gemini-flash-latest de reserva — as cotas do free tier são POR MODELO, e a
# do flash-lite é bem maior. Definir esta variável troca só o principal;
# os demais continuam de reserva para caso de 429/404.
# GEMINI_MODEL=gemini-flash-lite-latest
