# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# Usada apenas no servidor, pela rota /api/rename — nunca chega ao navegador.
GEMINI_API_KEY=

# Opcional: endpoint alternativo (proxy/mock). Padrão: API oficial da Google.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Opcional: modelo principal. Padrão: gemini-flash-lite-latest, com
# gemini-flash-latest de reserva — as cotas do free tier são POR MODELO, e a
# do flash-lite é bem maior. Definir esta variável troca só o principal;
# os demais continuam de reserva para caso de 429/404.
# GEMINI_MODEL=gemini-flash-lite-latest

# Postgres do Supabase (Dashboard -> Settings -> Database -> Connection string).
# O app usa o POOLER de transação (porta 6543, pgbouncer); as migrações usam a
# conexão direta (porta 5432) — o pooler não suporta DDL direito.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET=

# Login com Google (opcional — sem estas envs o botão não aparece).
# Google Cloud Console -> APIs e serviços -> Credenciais -> ID do cliente OAuth.
# URI de redirecionamento autorizado:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://SEU-DOMINIO/api/auth/callback/google     (produção)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
