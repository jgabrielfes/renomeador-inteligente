# QUAL SITE ESTE DEPLOY É — obrigatório.
#
# O repositório publica QUATRO sites independentes na Vercel a partir do mesmo
# código e do mesmo banco (ver lib/app.ts e AGENTS.md):
#
#   APP=hub           -> https://lexcausa.com.br (vitrine da marca)
#   APP=renomeador    -> https://renomeadorinteligente.lexcausa.com.br
#   APP=sucessorista  -> https://osucessorista.lexcausa.com.br
#   APP=notas         -> https://notasdevolutivas.lexcausa.com.br
#
# A raiz `/` de cada ferramenta é ela própria, o /admin mostra só as métricas
# dela, e as CONTAS são separadas (o mesmo e-mail tem uma conta em cada site).
# O hub é a exceção: vitrine pública, sem conta, sem banco e sem /admin — só a
# página com os cartões das ferramentas.
# Sem esta variável a aplicação não sobe — de propósito: publicar um site
# achando que é o outro seria pior que não publicar.
APP=renomeador

# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# Usada apenas no servidor, pela rota /api/rename — nunca chega ao navegador.
GEMINI_API_KEY=

# Opcional: endpoint alternativo (proxy/mock). Padrão: API oficial da Google.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Opcional: modelo principal. Padrão: gemini-flash-lite-latest, com
# gemini-flash-latest de reserva — as cotas do free tier são POR MODELO, e a
# do flash-lite é bem maior. Definir esta variável troca só o principal;
# os demais continuam de reserva para caso de 429/404.
# GEMINI_MODEL=gemini-flash-lite-latest

# Postgres do Supabase (Dashboard -> Settings -> Database -> Connection string).
# O app usa o POOLER de transação (porta 6543, pgbouncer); as migrações usam a
# conexão direta (porta 5432) — o pooler não suporta DDL direito.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET=

# Login com Google (opcional — sem estas envs o botão não aparece).
# Google Cloud Console -> APIs e serviços -> Credenciais -> ID do cliente OAuth.
#
# UM CLIENTE OAUTH POR SITE (cada projeto da Vercel recebe o seu par de
# envs). Origens JavaScript autorizadas e URIs de redirecionamento:
#
#   Renomeador
#     Origem:      https://renomeador-inteligente.vercel.app
#     Redirect:    https://renomeador-inteligente.vercel.app/api/auth/callback/google
#
#   Sucessorista
#     Origem:      https://osucessorista.vercel.app
#     Redirect:    https://osucessorista.vercel.app/api/auth/callback/google
#
#   Desenvolvimento (serve para os três — o APP é que muda)
#     Origem:      http://localhost:3000
#     Redirect:    http://localhost:3000/api/auth/callback/google
#   MODO GOOGLE DRIVE (Sucessorista): o MESMO cliente OAuth precisa, além do
#   callback de login, do redirect https://<dominio>/api/drive/callback e da
#   API do Google Drive ATIVADA no projeto (escopo drive.file no consent).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# TRANCA DO AMBIENTE DE HOMOLOGAÇÃO (opcional).
#
# Com as DUAS preenchidas, o site inteiro passa a pedir usuário e senha na
# janelinha nativa do navegador antes de qualquer página carregar (proxy.ts).
# Faltando qualquer uma, não há tranca nenhuma — é assim que produção roda.
#
# Na Vercel: defina as duas no ambiente **Preview** de cada projeto (a
# `develop`) e NÃO defina em Production. Nada aqui substitui o login da
# aplicação, que continua valendo normalmente depois da tranca.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Contato exibido no rodapé da vitrine (APP=hub). Sem a variável vale
# contato@lexcausa.com.br.
# HUB_EMAIL_CONTATO=contato@lexcausa.com.br
