// Schema mínimo de autenticação: login por credenciais com papel de acesso.
// (NextAuth roda com sessão JWT — sem tabelas de sessão/conta por enquanto.)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MASTER verá telas exclusivas de administração no futuro.
enum Role {
  USER
  MASTER
}

// Os DOIS sites publicados a partir deste repositório (variável de ambiente
// APP — ver lib/app.ts). O banco é compartilhado, mas cada linha sabe de qual
// plataforma veio: conta, telemetria e erros nunca se misturam entre os dois.
enum Plataforma {
  RENOMEADOR
  SUCESSORISTA
  NOTAS
}

// Perfil de uso do Sucessorista, VINCULADO à conta: escolhido uma única vez
// no primeiro acesso; usuário comum não circula pelos dois (só MASTER).
enum PerfilSucessorista {
  ADVOGADO
  NAO_ADVOGADO
}

// Papel dentro da EQUIPE: o chefe gere (convida/remove membros); o membro
// faz tudo no módulo, exceto gerir a equipe.
enum PapelEquipe {
  CHEFE
  MEMBRO
}

// EQUIPE de trabalho do Sucessorista: contas INDIVIDUAIS vinculadas por
// convite do chefe (advogado ou escrevente). O compartilhamento dos CASOS é
// operacional — a mesma pasta-raiz no Drive/OneDrive, com a guarda de
// conflito arbitrando; a equipe governa o vínculo de pessoas e o perfil.
// Convite com `acessoCasos` abre também a NUVEM DA EQUIPE (EquipeCaso).
model Equipe {
  id        String   @id @default(cuid())
  nome      String
  app       Plataforma
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros  User[]
  convites EquipeConvite[]
  casos    EquipeCaso[]

  @@map("equipes")
}

// Convite de equipe: CÓDIGO de uso único gerado pelo chefe — o membro entra
// com a própria conta e cola o código (sem rota pública nova). `acessoCasos`
// marca o convite de ACESSO TOTAL: quem entra com ele enxerga todos os casos
// do chefe pela nuvem da equipe (como se o chefe autorizasse o próprio
// acervo), continuando sem poder gerir a equipe.
model EquipeConvite {
  token       String    @id
  equipeId    String
  equipe      Equipe    @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  acessoCasos Boolean   @default(false)
  criadoEm    DateTime  @default(now())
  usadoEm     DateTime?
  usadoPorId  String?

  @@map("equipe_convites")
}

// NUVEM DA CONTA — espelho do caso.json POR USUÁRIO (sem exigir equipe):
// é o que faz o login "puxar" os casos em qualquer computador. Mesma regra
// da nuvem da equipe: só a folha sobe, documento NUNCA; nada em /admin.
// A chave é (userId, id) — dois usuários que dividem a mesma pasta no Drive
// podem espelhar o MESMO caseId sem um sobrescrever o outro.
model ContaCaso {
  id            String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabecalho     Json
  arquivo       Json
  atualizadoEm  DateTime
  atualizadoPor String
  criadoEm      DateTime @default(now())

  @@id([userId, id])
  @@map("conta_casos")
}

// NUVEM DA EQUIPE: espelho do `caso.json` (folha do caso, SEM os documentos
// — arquivos nunca sobem, fronteira de dados) para o chefe compartilhar
// todos os casos com quem entrou por convite de acesso total. `cabecalho` é
// coluna própria para a listagem não carregar o arquivo inteiro. Dado do
// PRÓPRIO escritório, como renamer_lessons: NUNCA exibir em /admin.
model EquipeCaso {
  id            String   @id // caseId aleatório gerado no cliente
  equipeId      String
  equipe        Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  cabecalho     Json
  arquivo       Json
  atualizadoEm  DateTime
  atualizadoPor String
  criadoEm      DateTime @default(now())

  @@index([equipeId])
  @@map("equipe_casos")
}

// Convite do PORTAL DO HERDEIRO — PERSISTIDO (o memoryStore zerava a cada
// cold start da Vercel: link "expirando" e envios sumindo). O token é a
// credencial (o herdeiro não tem login) e o convite NÃO expira. `dados` é o
// ConviteHerdeiro inteiro (lib/portal/store.ts): pedidos, status, nome
// proposto dos arquivos e a qualificação preenchida — os ARQUIVOS continuam
// no navegador do herdeiro (fronteira de dados), aqui nunca entra conteúdo
// de documento.
model PortalConvite {
  token     String   @id
  casoId    String
  dados     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  arquivos  PortalArquivo[]

  @@map("portal_convites")
}

// Arquivo REAL enviado pelo herdeiro pelo portal — exceção CONSCIENTE (opt-in
// do escritório) à fronteira de dados: o documento repousa no banco até o
// advogado baixá-lo/anexá-lo ao caso. VÁRIOS arquivos por pedido (frente e
// verso, correlatos — migração `varios_arquivos_por_pedido`); o herdeiro
// pode APAGAR um envio seu enquanto o pedido não foi aprovado; excluir o
// convite apaga os arquivos em cascata. Teto de 25 MB por arquivo — acima
// de ~3,5 MB o navegador do herdeiro envia em FATIAS (PortalArquivoParte) e
// a última remonta aqui. NUNCA exibir em /admin.
model PortalArquivo {
  id        String        @id @default(cuid())
  token     String
  convite   PortalConvite @relation(fields: [token], references: [token], onDelete: Cascade)
  // Pedido do convite a que o arquivo responde (DocumentoPedido.id).
  docId     String
  nome      String
  mime      String
  tamanho   Int
  conteudo  Bytes
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([token, docId])
  @@map("portal_arquivos")
}

// Fatia TEMPORÁRIA de um upload fatiado do portal (arquivo acima do limite
// de ~4,5 MB por requisição da Vercel): cada requisição grava uma fatia e a
// última remonta o arquivo em portal_arquivos e apaga as fatias. `envioId` é
// aleatório do navegador do herdeiro; fatias órfãs (envio abandonado) são
// varridas por melhor-esforço a cada upload novo (criadoEm > 24h).
model PortalArquivoParte {
  envioId  String
  indice   Int
  dados    Bytes
  criadoEm DateTime @default(now())

  @@id([envioId, indice])
  @@map("portal_arquivo_partes")
}

// Painel do Cliente — o ESPELHO PUBLICADO do caso para a família: uma linha
// por caso, contendo SÓ o snapshot FILTRADO montado no navegador do advogado
// (lib/portal/painel.ts — allowlist campo a campo, um painel por convite).
// O caso completo NUNCA sobe; honorários/notas/folha ficam fora por
// construção. Encerrar o compartilhamento apaga esta linha (cascade nos
// eventos) e os convites do caso. NUNCA exibir em /admin.
model PortalPainel {
  casoId       String   @id
  // Dono do espelho (quem publicou) — as actions validam dono OU equipe.
  userId       String
  // Record<token, PainelHerdeiro> — o recorte de cada herdeiro.
  snapshot     Json
  // VisibilidadePainel vigente (contato/custos/quinhão) — para reabrir a UI.
  visibilidade Json
  // Espaço do Espólio (camada 2): o snapshot COMPARTILHADO — igual para
  // todos os herdeiros do caso (lib/portal/espolio.ts). Null = fechado.
  espolio      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portal_paineis")
}

// FATOS VIVOS do Espaço do Espólio — imutáveis por desenho: o texto nunca é
// editado nem apagado; a decisão do advogado só muda status/motivo, e
// correção é uma LINHA NOVA. Sem FK (mesma lição de portal_eventos); quem
// apaga é o Encerrar compartilhamento. Nomes de herdeiro são dado do
// próprio escritório — NUNCA em /admin.

// Comentário ou sugestão de valor de um HERDEIRO sobre um bem do espólio.
// Nada muda no caso sem o advogado: sugestão aceita é aplicada por ELE no
// acervo local (e só vale para a família após republicar).
model EspolioNota {
  id            String    @id @default(cuid())
  casoId        String
  // Convite autor + nome (os herdeiros veem uns aos outros no espólio).
  token         String
  autor         String
  bemId         String
  tipo          String    // 'comentario' | 'sugestao_valor'
  texto         String
  valorSugerido String?
  status        String    @default("pendente") // pendente|aceita|recusada
  motivo        String?
  decididaEm    DateTime?
  createdAt     DateTime  @default(now())

  @@index([casoId, createdAt])
  @@map("espolio_notas")
}

// Despesa ADIANTADA por um herdeiro (funeral, IPTU, condomínio, ITCMD…):
// a maior fonte de ressentimento em inventário, agora contabilizada. O
// comprovante é o pedido `despesa-<id>` do convite (reusa portal_arquivos).
// Reconhecida entra nos cenários de partilha (ressarcir × compensar).
model EspolioDespesa {
  id         String    @id @default(cuid())
  casoId     String
  token      String
  autor      String
  // Herdeiro do caso (participanteId nos cenários) — vem do convite.
  herdeiroId String?
  categoria  String
  valor      String
  data       String
  descricao  String
  status     String    @default("pendente") // pendente|reconhecida|nao_reconhecida
  motivo     String?
  tratamento String    @default("ressarcir") // ressarcir|compensar
  decididaEm DateTime?
  createdAt  DateTime  @default(now())

  @@index([casoId, createdAt])
  @@map("espolio_despesas")
}

// CENÁRIO de divisão proposto à família (simulador do Espaço do Espólio):
// `dados` é o snapshot LEIGO montado no navegador do advogado (título,
// linhas por participante, mapa bem→destino, avisos) + as `alocacoes` (o
// MESMO formato do `atribuicoesPct` da seção III — "levar para a partilha"
// é cópia direta). Enquanto `proposto`, o advogado pode ajustar; `congelado`
// (consenso ou fecho manual) trava tudo; `retirado` sai da conversa mas fica
// registrado. Sem FK; quem apaga é o Encerrar compartilhamento.
model EspolioCenario {
  id        String   @id @default(cuid())
  casoId    String
  dados     Json
  status    String   @default("proposto") // proposto|congelado|retirado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([casoId, createdAt])
  @@map("espolio_cenarios")
}

// ADESÃO de um herdeiro a um cenário — imutável e append-only: mudar de
// ideia é registrar resposta nova (a mais recente vale); o histórico inteiro
// fica para o registro de atendimento. Consenso = a resposta mais recente de
// TODO convite ativo é "aceito" — congela o cenário.
model EspolioAdesao {
  id         String   @id @default(cuid())
  cenarioId  String
  casoId     String
  token      String
  autor      String
  resposta   String   // aceito|nao_aceito|conversar
  comentario String?
  createdAt  DateTime @default(now())

  @@index([cenarioId, createdAt])
  @@index([casoId, createdAt])
  @@map("espolio_adesoes")
}

// VOTAÇÃO formal do espólio (deliberação em duas etapas): o advogado ABRE
// (pergunta + opções fechadas em `dados`, com aviso por e-mail) e ENCERRA
// (apuração + termo de deliberação em PDF no navegador). `dados` é leigo,
// montado no cliente; encerrada não reabre — deliberação nova é outra linha.
// Sem FK; quem apaga é o Encerrar compartilhamento.
model EspolioVotacao {
  id          String    @id @default(cuid())
  casoId      String
  dados       Json
  status      String    @default("aberta") // aberta|encerrada
  encerradaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([casoId, createdAt])
  @@map("espolio_votacoes")
}

// VOTO de um herdeiro — imutável e append-only: mudar o voto é linha nova
// enquanto a votação está aberta (a mais recente vale); o histórico inteiro
// fica para o termo e o registro de atendimento.
model EspolioVoto {
  id         String   @id @default(cuid())
  votacaoId  String
  casoId     String
  token      String
  autor      String
  opcaoId    String
  comentario String?
  createdAt  DateTime @default(now())

  @@index([votacaoId, createdAt])
  @@index([casoId, createdAt])
  @@map("espolio_votos")
}

// MURAL da família — mensagem de herdeiro com MODERAÇÃO PRÉVIA: só aparece
// para os demais depois que o escritório aprova (recusa exige motivo, que o
// autor lê). Imutável e append-only: a mensagem nunca é editada; a moderação
// só muda status/motivo/decididaEm. Sem FK; quem apaga é o Encerrar.
model EspolioMural {
  id         String    @id @default(cuid())
  casoId     String
  token      String
  autor      String
  texto      String
  status     String    @default("pendente") // pendente|aprovada|recusada
  motivo     String?
  decididaEm DateTime?
  createdAt  DateTime  @default(now())

  @@index([casoId, createdAt])
  @@map("espolio_mural")
}

// ÁREA PÚBLICA "Para famílias" (camada 3): o questionário salvo. AQUI a
// plataforma é CONTROLADORA (LGPD) — diferente das camadas 1–2. Sem dado
// sensível por desenho (sem CPF, sem nome do falecido, sem endereço; bens
// por FAIXA). `tokenGestao` é a credencial do link "meu resultado" (mesmo
// padrão do portal: token = credencial, sem login). Retenção: intake não
// reclamado expira em 90 dias (expiraEm); retirado é APAGADO na hora.
model FamiliaIntake {
  id                String    @id @default(cuid())
  respostas         Json
  resultado         Json
  nome              String?
  email             String?
  emailConfirmadoEm DateTime?
  consentimentoEm   DateTime?
  status            String    @default("resultado") // rascunho|resultado|publicado|em_conversa|contratado|retirado|expirado
  uf                String
  cidade            String
  pequenoValor      Boolean   @default(false)
  tokenGestao       String    @unique
  expiraEm          DateTime
  // RADAR — publicação anonimizada (camada 3, etapa 4): a publicação SÓ
  // acontece com consentimento específico + e-mail confirmado pelo link
  // (confirmacaoToken, uso único). aviso72hEm marca o aviso honesto de
  // "ninguém respondeu ainda" (enviado uma vez pela varredura do admin).
  confirmacaoToken  String?   @unique
  publicadoEm       DateTime?
  aviso72hEm        DateTime?
  // Conversa 1:1 (etapa 5): a família escolhe UM(A) advogado(a) por vez —
  // "Quero conversar" grava quem; encerrar limpa e o caso volta ao Radar;
  // 30 dias sem confirmação de contratação reabrem sozinhos (na leitura).
  conversaAdvogadoUserId String?
  conversaAbertaEm       DateTime?
  contratadoEm           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, uf, createdAt])
  @@map("familia_intakes")
}

// RADAR — lado do(a) advogado(a) (camada 3, etapa 5). Ética OAB (Provimento
// 205/2021): verificação da OAB é MANUAL (fila no /admin), a assinatura é
// MENSAL e marcada à mão por UF (nunca comissão por caso), a resposta não tem
// campo de honorários e a lista não tem ranking — ordenação única por data.
model AdvogadoPerfil {
  id                 String    @id @default(cuid())
  userId             String    @unique
  oab                String
  oabUf              String
  situacao           String    @default("pendente") // pendente|aprovado|recusado|suspenso
  motivoRecusa       String?
  quizAprovadoEm     DateTime?
  aceitaPequenoValor Boolean   @default(false)
  /// Última visita à lista do Radar — o que separa "caso novo" de "já visto"
  /// (o aviso é DENTRO da plataforma; e-mail de caso novo não existe).
  radarVistoEm       DateTime?
  /// VITRINE pública (o que a família vê junto da candidatura, sempre com
  /// nome + OAB): áreas de atuação e experiência — informação sóbria, sem
  /// promessa de resultado (Provimento 205/2021). Avaliações NÃO existem.
  areasAtuacao       String?
  experiencia        String?
  /// CRÉDITOS do Radar: concedidos com a assinatura do aplicativo (geridos à
  /// mão no /admin/radar) e consumidos 1 a 1 na CANDIDATURA — sem restrição
  /// por UF. Crédito é preço de USO (consome tenha ou não retorno da
  /// família): nunca comissão por caso ou por êxito. Saldo atualizado na
  /// MESMA transação do ledger radar_creditos.
  creditosRadar      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("advogado_perfis")
}

// Ledger IMUTÁVEL dos créditos do Radar: cada concessão/ajuste da
// administração e cada consumo de candidatura vira uma linha — o saldo em
// advogado_perfis.creditosRadar anda junto, na mesma transação.
model RadarCredito {
  id        String   @id @default(cuid())
  userId    String
  /// Positivo = concessão/ajuste; negativo = consumo (candidatura = -1).
  delta     Int
  motivo    String   // 'assinatura' | 'ajuste' | 'candidatura'
  /// Candidatura: o caso que consumiu o crédito.
  intakeId  String?
  /// Admin que concedeu/ajustou (null = consumo automático).
  criadoPor String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("radar_creditos")
}

model RadarAssinatura {
  id        String   @id @default(cuid())
  userId    String
  uf        String
  origem    String   @default("assinante_manual") // sem gateway de pagamento (fora de escopo)
  createdAt DateTime @default(now())

  @@unique([userId, uf])
  @@map("radar_assinaturas")
}

// Resposta de apresentação a um caso anônimo: teto de 5 por caso (validado na
// action), uma por advogado(a), textos limitados (600/800) e SEM valores.
model RadarResposta {
  id             String   @id @default(cuid())
  intakeId       String
  advogadoUserId String
  apresentacao   String
  conducao       String
  createdAt      DateTime @default(now())

  @@unique([intakeId, advogadoUserId])
  @@index([intakeId, createdAt])
  @@map("radar_respostas")
}

// Canal 1:1 aberto pelo "Quero conversar" — só a família e o(a) advogado(a)
// escolhido(a) leem; o histórico permanece para a família mesmo após encerrar.
model RadarMensagem {
  id             String   @id @default(cuid())
  intakeId       String
  advogadoUserId String
  autor          String   // advogado|familia
  texto          String
  createdAt      DateTime @default(now())

  @@index([intakeId, advogadoUserId, createdAt])
  @@map("radar_mensagens")
}

// HANDOFF do intake ao advogado: a família gera um CÓDIGO de uso único e o
// advogado, logado, "Importa caso de família" — o caso nasce NO NAVEGADOR
// dele (local-first; intakeParaCaso), nunca no servidor. Confirmada a
// importação, o intake é PODADO (respostas/resultado apagados; fica só o
// histórico da solicitação e do aceite).
model IntakeHandoff {
  id             String    @id @default(cuid())
  intakeId       String
  codigo         String    @unique
  advogadoUserId String?
  importadoEm    DateTime?
  confirmadoEm   DateTime?
  createdAt      DateTime  @default(now())

  @@index([intakeId])
  @@map("intake_handoffs")
}

// Registro de atendimento do Painel do Cliente: convites, acessos, fases,
// documentos aceitos/recusados, notificações — o histórico que protege o
// advogado (relatório de comunicação com a família). SEM FK para o painel:
// convite e acesso acontecem ANTES de publicar; quem apaga os eventos é o
// "Encerrar compartilhamento" (deleteMany explícito). Rótulos, nomes de
// herdeiro e motivos de recusa (dado do PRÓPRIO escritório) — nunca
// conteúdo de documento e NUNCA em /admin.
model PortalEvento {
  id        String   @id @default(cuid())
  casoId    String
  // Convite relacionado, quando o evento é de um herdeiro específico.
  token     String?
  tipo      String
  detalhe   Json?
  createdAt DateTime @default(now())

  @@index([casoId, createdAt])
  @@map("portal_eventos")
}

model User {
  id           String    @id @default(cuid())
  name         String
  // A conta é POR PLATAFORMA: o mesmo e-mail pode existir nos dois sites como
  // duas contas independentes (senha, papel e dados próprios). Quem se
  // cadastra num deles não entra no outro sem criar conta lá.
  email        String
  app          Plataforma
  // Sem confirmação de e-mail por enquanto: null = "e-mail não confirmado"
  // (a UI marca). Quando a confirmação existir, recebe a data.
  // Login com Google já nasce confirmado (o Google atesta o e-mail).
  emailVerified DateTime?
  // Null = conta criada via Google (entra só pelo OAuth, sem senha).
  passwordHash String?
  // PERFIL do usuário (/config): foto pequena (data URL JPEG redimensionada
  // NO NAVEGADOR — nunca arquivo bruto), bio/apresentação, endereço do
  // escritório e contatos de trabalho. Tudo opcional, editado pelo próprio.
  fotoPerfil         String?
  bio                String?
  enderecoEscritorio String?
  telefoneContato    String?
  emailContato       String?
  // Escrevente Notarial: a serventia onde trabalha (qualificação do
  // primeiro acesso — o advogado tem o AdvogadoPerfil, o escrevente tem isto).
  serventia          String?
  role         Role      @default(USER)
  // Null = ainda não escolheu (primeiro acesso ao Sucessorista pergunta).
  perfilSucessorista PerfilSucessorista?
  // Equipe de trabalho (null = sem equipe). O papel decide quem GERE.
  equipeId    String?
  equipe      Equipe?      @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  papelEquipe PapelEquipe?
  // true = entrou por convite de ACESSO TOTAL: enxerga a nuvem de casos da
  // equipe (o chefe sempre enxerga, independentemente desta flag).
  acessoCasosEquipe Boolean @default(false)
  // GOOGLE DRIVE conectado (Sucessorista): refresh token do escopo
  // drive.file — a aplicação só enxerga a pasta que ELA criou no Drive do
  // usuário. Null = não conectado. Desconectar revoga no Google e limpa.
  driveRefreshToken String?
  driveEmail        String?
  driveConectadoEm  DateTime?
  // ONEDRIVE conectado (Sucessorista): refresh token do escopo
  // Files.ReadWrite.AppFolder — a aplicação só enxerga a pasta de app
  // ("Apps/O Sucessorista") no OneDrive do usuário. O refresh token da
  // Microsoft ROTACIONA a cada renovação: tokenOneDrive() regrava a coluna.
  oneDriveRefreshToken String?
  oneDriveEmail        String?
  oneDriveConectadoEm  DateTime?
  // DROPBOX conectado (Sucessorista): refresh token de app com acesso "App
  // folder" — a aplicação só enxerga a pasta "Apps/O Sucessorista" no
  // Dropbox do usuário. O refresh token do Dropbox NÃO rotaciona.
  dropboxRefreshToken String?
  dropboxEmail        String?
  dropboxConectadoEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  renameEvents RenameEvent[]
  errorEvents  ErrorEvent[]
  lessons      RenamerLessons?
  accesses     ModuleAccess[]
  notaEvents   NotaEvent[]
  sucessoristaEvents SucessoristaEvent[]
  casosNuvem   ContaCaso[]
  passwordResets PasswordReset[]

  @@unique([email, app])
  @@map("users")
}

// REDEFINIÇÃO DE SENHA ("esqueci minha senha"): token de uso único enviado por
// e-mail (env-gated pelo Resend, como o portal). Só o HASH SHA-256 do token
// fica no banco — vazamento da tabela não entrega link válido. Expira em 1h;
// o uso carimba usadoEm (token não se reaproveita). Cascade: conta apagada
// leva os pedidos junto.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

// Ferramentas da plataforma — dimensão comum das métricas de uso.
enum Modulo {
  RENOMEADOR
  NOTAS
  SUCESSORISTA
}

// Abertura de um módulo: uma linha por módulo por sessão do navegador (a
// guarda do "uma vez por sessão" é do cliente — components/access-tracker).
// NÃO é login: mede quem abriu qual ferramenta, e quantas vezes.
model ModuleAccess {
  id        String   @id @default(cuid())
  modulo    Modulo
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, modulo])
  @@map("module_accesses")
}

// Aprendizado do escritório do renomeador ("Regras do escritório" + correções
// capturadas quando o usuário edita um nome sugerido) — POR CONTA. Vivia no
// localStorage; agora acompanha o usuário em qualquer navegador.
// É dado do PRÓPRIO usuário (as correções contêm nomes que ele digitou):
// nunca exibir em /admin nem tratar como telemetria.
model RenamerLessons {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Texto livre do card "Regras do escritório", injetado nos prompts da IA.
  regras    String   @default("")
  // Array<{ tipo, sugerido, corrigido }> — exemplos few-shot (máx. 20).
  correcoes Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("renamer_lessons")
}

// Registro de erros da plataforma (hoje: falhas das rotas de IA). Sem conteúdo
// de documento — só origem, mensagem truncada, status e quem estava logado
// (null = deslogado). Alimenta /admin/erros.
model ErrorEvent {
  id        String   @id @default(cuid())
  origem    String
  mensagem  String
  status    Int?
  // Plataforma onde o erro aconteceu (null = registro anterior à separação
  // dos dois sites, quando a plataforma era uma só).
  app       Plataforma?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("error_events")
}

// Como cada lote foi analisado no renomeador.
enum MetodoAnalise {
  IA_ARQUIVO // documento enviado inteiro ao Gemini
  IA_TEXTO   // OCR local + texto enviado ao Gemini
  LOCAL      // 100% no navegador (modo local ou fallback)
}

// Telemetria do renomeador: um evento por método dentro de cada rodada de
// ANÁLISE (registrado quando os arquivos são enviados para IA/OCR, não na
// renomeação final). Alimenta o resumo e a listagem de /admin.
// Privacidade: NENHUM nome de arquivo/pessoa é gravado — `itens` guarda só a
// TAG de tipo de cada documento e flags de download. Visível para MASTER.
model RenameEvent {
  id         String        @id @default(cuid())
  quantidade Int
  metodo     MetodoAnalise @default(LOCAL)
  // Onde o lote foi analisado. O Renomeador é embutido no cofre do
  // Sucessorista, então um lote pode nascer em qualquer um dos dois sites — o
  // evento conta para o painel da plataforma em que a pessoa estava.
  // null = registro anterior à separação.
  app        Plataforma?
  // Duração total do processamento daquele método na rodada, em ms.
  duracaoMs  Int?
  // Array<{ tipo: string; baixado?: boolean; otimizado?: boolean }>
  itens      Json?
  // { zip?: boolean; montagem?: { subpastas; converterPdf; numerar } } —
  // preenchido depois, quando o lote é baixado/aplicado.
  desfecho   Json?
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@map("rename_events")
}

// Telemetria do Resolvedor de Notas: um evento por TRIAGEM de nota
// devolutiva (o momento em que a nota é decomposta em exigências e cada uma
// é classificada numa via de resolução). Os desfechos de cada exigência
// (via corrigida à mão, minuta gerada, download) são gravados depois, por
// índice, como no renomeador.
// Privacidade: NADA do texto da nota, nomes de pessoa/arquivo, prenotação ou
// serventia — só as TAGS do vocabulário fechado do módulo e contagens.
model NotaEvent {
  id         String   @id @default(cuid())
  // Exigências detectadas na nota.
  quantidade Int
  // Fonte do texto: docx | pdf-nativo | pdf-escaneado | texto | imagem | outro
  fonte      String
  // true = texto colado/corrigido à mão (a leitura automática da pasta falhou).
  manual     Boolean  @default(false)
  // Arquivos indexados na pasta do caso (0 = trabalhou sem pasta).
  arquivos   Int      @default(0)
  duracaoPasta Int?
  duracaoMs  Int?
  // Array<{ via, alvos: string[], temGatilho, pessoas: number,
  //          viaFinal?, status?, peca?, comIa?, camposIa?, faltando?,
  //          baixouMinuta?, baixouJuntada?, achadosNaPasta? }>
  itens      Json?
  // { minutas?: number; downloads?: number; resolvidos?: number }
  desfecho   Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@map("notas_events")
}

// Ações medidas no Sucessorista (uma linha por ação relevante do caso).
enum AcaoSucessorista {
  LEITURA_COFRE // etapa 0: documentos lidos pela IA
  CALCULO       // espelho da partilha calculado (o caso "fechou")
  DOCUMENTO     // minuta/planilha/processo gerado
  PORTAL        // convite ao herdeiro gerado
}

// Telemetria do Sucessorista. Privacidade: nenhum nome de parte, CPF, nome de
// arquivo ou VALOR ABSOLUTO do acervo — o porte do caso entra como FAIXA
// (decisão explícita do dono do produto), o resto é contagem/tag/enum.
model SucessoristaEvent {
  id         String           @id @default(cuid())
  acao       AcaoSucessorista
  // Identificador aleatório do caso (crypto.randomUUID no cliente) — amarra os
  // eventos de um mesmo inventário SEM identificar ninguém. Permite contar
  // casos distintos e atualizar o retrato do caso em vez de duplicar linhas.
  casoId     String?
  // Perfil ativo na lombada: ADVOGADO | ESCREVENTE.
  perfil     String?
  // Documentos lidos, arquivos gerados, herdeiros do caso… (depende da ação).
  quantidade Int              @default(0)
  duracaoMs  Int?
  // Contexto estrutural: { herdeiros, bens, tiposBem[], regime, vinculo, rito,
  //   porte, temSobrevivente, incapaz, isencoes, progressivo, documento, tipos[] }
  dados      Json?
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([casoId, acao])
  @@map("sucessorista_events")
}

// Denúncia da FAMÍLIA sobre uma resposta/conduta no Radar (promessa de
// resultado, cobrança pela plataforma, contato fora do combinado…). Decisão
// do admin em /admin/radar: ACATAR suspende o perfil; arquivar mantém.
model RadarDenuncia {
  id             String    @id @default(cuid())
  intakeId       String
  advogadoUserId String
  motivo         String
  status         String    @default("pendente") // pendente|acatada|arquivada
  createdAt      DateTime  @default(now())
  decididoEm     DateTime?

  @@index([status, createdAt])
  @@map("radar_denuncias")
}

// CAMADA 4 — Rede advogado-advogado, pilar A: o SEGUNDO advogado no caso.
// Ele entra por CONTA (OAB aprovada, camada 3) — token é credencial de
// leigo; a janela dele no caso é um convite-espelho do portal
// (papelConvite 'advogado'). `representaTokens` = convites de herdeiro que
// ele representa (o escopo de leitura dos painéis individuais).
model CasoAdvogado {
  id                 String   @id @default(cuid())
  casoId             String
  advogadoUserId     String
  convidadoPorUserId String
  indicadoPor        String   @default("titular") // titular|herdeiro
  representaTokens   Json
  conviteToken       String   @unique
  status             String   @default("ativo") // ativo|removido
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([casoId, advogadoUserId])
  @@index([advogadoUserId, status])
  @@map("caso_advogados")
}

// Canal 1:1 entre os advogados do caso (pilar A, etapa A2) — registrado e
// exportável; nada disto circula para herdeiros nem para /admin.
model CasoAdvogadoMensagem {
  id        String   @id @default(cuid())
  casoId    String
  deUserId  String
  texto     String
  createdAt DateTime @default(now())

  @@index([casoId, createdAt])
  @@map("caso_advogado_mensagens")
}

// CAMADA 4, pilar B — CORRESPONDENTES de sucessões por comarca. Extensão do
// perfil verificado (camada 3): comarcas por código IBGE (sem dígito), tipos
// de diligência e prazos. Só aparece nas buscas com selo (OAB aprovada +
// quiz) e perfil ATIVO; a ordem de exibição é NEUTRA (motor puro em
// lib/rede/diligencias.ts) — nunca por preço ou nota.
model CorrespondentePerfil {
  userId         String   @id
  comarcas       Json     // number[] — códigos IBGE
  tipos          Json     // TipoDiligencia[]
  prazoMedioDias Int      @default(5)
  raioKm         Int      @default(0)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("correspondente_perfis")
}

// A DILIGÊNCIA: nasce de um caso (casoId) ou avulsa; a PASTA é o conjunto
// isolado de arquivos (DiligenciaArquivo) — o correspondente NUNCA vê o
// caso. termoJson registra o combinado ENTRE os advogados (escopo, prazo,
// valor em texto livre) — a plataforma não processa pagamento.
model Diligencia {
  id                     String    @id @default(cuid())
  solicitanteUserId      String
  casoId                 String?
  comarcaIbge            Int
  municipio              String
  uf                     String
  tipo                   String
  descricao              String
  prazoEm                DateTime?
  status                 String    @default("aberta") // lib/rede/diligencias.ts
  correspondenteUserId   String?
  termoJson              Json?
  justificativaAtraso    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, uf, comarcaIbge])
  @@index([solicitanteUserId])
  @@index([correspondenteUserId])
  @@map("diligencias")
}

// Arquivo da PASTA da diligência: origem 'pasta' (anexado pelo solicitante)
// ou 'relatorio' (entregue pelo correspondente). Fora da pasta, nada circula
// (conteudoDaPasta, com teste). NUNCA em /admin.
model DiligenciaArquivo {
  id           String   @id @default(cuid())
  diligenciaId String
  origem       String   // pasta|relatorio
  nome         String
  mime         String
  tamanho      Int
  conteudo     Bytes
  createdAt    DateTime @default(now())

  @@index([diligenciaId])
  @@map("diligencia_arquivos")
}

model DiligenciaOferta {
  id                   String   @id @default(cuid())
  diligenciaId         String
  correspondenteUserId String
  mensagem             String
  prazoDias            Int
  createdAt            DateTime @default(now())

  @@unique([diligenciaId, correspondenteUserId])
  @@map("diligencia_ofertas")
}

// Avaliação MÚTUA por critérios objetivos (prazo/relatório/comunicação,
// 1–5) — agregada no perfil só para assinantes logados; nunca pública.
model DiligenciaAvaliacao {
  id             String   @id @default(cuid())
  diligenciaId   String
  avaliadorUserId String
  avaliadoUserId String
  criterios      Json
  createdAt      DateTime @default(now())

  @@unique([diligenciaId, avaliadorUserId])
  @@map("diligencia_avaliacoes")
}

// FEEDBACK da plataforma (dialog "Reportar problema" / "Sugestão" do shell):
// título + descrição livres do usuário, com a página registrada
// automaticamente. Sem FK de propósito (o relato sobrevive à conta); a
// coluna app segue a fronteira dos três sites — /admin filtra por ela.
// A severidade/status é classificada pela equipe em /admin/feedback.
model Feedback {
  id        String     @id @default(cuid())
  app       Plataforma
  userId    String?
  userEmail String?
  tipo      String // 'bug' | 'sugestao'
  categoria String? // sugestão: funcionalidade | usabilidade | outro
  titulo    String
  descricao String
  pagina    String?
  status    String     @default("aberto") // aberto | em_analise | resolvido
  // RESPOSTA da equipe ao relato — o usuário a lê em "Meus Envios".
  resposta     String?
  respondidoEm DateTime?
  createdAt DateTime   @default(now())

  @@index([app, createdAt])
  @@map("feedbacks")
}
