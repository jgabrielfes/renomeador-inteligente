// Schema mínimo de autenticação: login por credenciais com papel de acesso.
// (NextAuth roda com sessão JWT — sem tabelas de sessão/conta por enquanto.)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MASTER verá telas exclusivas de administração no futuro.
enum Role {
  USER
  MASTER
}

// Os DOIS sites publicados a partir deste repositório (variável de ambiente
// APP — ver lib/app.ts). O banco é compartilhado, mas cada linha sabe de qual
// plataforma veio: conta, telemetria e erros nunca se misturam entre os dois.
enum Plataforma {
  RENOMEADOR
  SUCESSORISTA
}

model User {
  id           String    @id @default(cuid())
  name         String
  // A conta é POR PLATAFORMA: o mesmo e-mail pode existir nos dois sites como
  // duas contas independentes (senha, papel e dados próprios). Quem se
  // cadastra num deles não entra no outro sem criar conta lá.
  email        String
  app          Plataforma
  // Sem confirmação de e-mail por enquanto: null = "e-mail não confirmado"
  // (a UI marca). Quando a confirmação existir, recebe a data.
  // Login com Google já nasce confirmado (o Google atesta o e-mail).
  emailVerified DateTime?
  // Null = conta criada via Google (entra só pelo OAuth, sem senha).
  passwordHash String?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  renameEvents RenameEvent[]
  errorEvents  ErrorEvent[]
  lessons      RenamerLessons?
  accesses     ModuleAccess[]
  notaEvents   NotaEvent[]
  sucessoristaEvents SucessoristaEvent[]

  @@unique([email, app])
  @@map("users")
}

// Ferramentas da plataforma — dimensão comum das métricas de uso.
enum Modulo {
  RENOMEADOR
  NOTAS
  SUCESSORISTA
}

// Abertura de um módulo: uma linha por módulo por sessão do navegador (a
// guarda do "uma vez por sessão" é do cliente — components/access-tracker).
// NÃO é login: mede quem abriu qual ferramenta, e quantas vezes.
model ModuleAccess {
  id        String   @id @default(cuid())
  modulo    Modulo
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, modulo])
  @@map("module_accesses")
}

// Aprendizado do escritório do renomeador ("Regras do escritório" + correções
// capturadas quando o usuário edita um nome sugerido) — POR CONTA. Vivia no
// localStorage; agora acompanha o usuário em qualquer navegador.
// É dado do PRÓPRIO usuário (as correções contêm nomes que ele digitou):
// nunca exibir em /admin nem tratar como telemetria.
model RenamerLessons {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Texto livre do card "Regras do escritório", injetado nos prompts da IA.
  regras    String   @default("")
  // Array<{ tipo, sugerido, corrigido }> — exemplos few-shot (máx. 20).
  correcoes Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("renamer_lessons")
}

// Registro de erros da plataforma (hoje: falhas das rotas de IA). Sem conteúdo
// de documento — só origem, mensagem truncada, status e quem estava logado
// (null = deslogado). Alimenta /admin/erros.
model ErrorEvent {
  id        String   @id @default(cuid())
  origem    String
  mensagem  String
  status    Int?
  // Plataforma onde o erro aconteceu (null = registro anterior à separação
  // dos dois sites, quando a plataforma era uma só).
  app       Plataforma?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("error_events")
}

// Como cada lote foi analisado no renomeador.
enum MetodoAnalise {
  IA_ARQUIVO // documento enviado inteiro ao Gemini
  IA_TEXTO   // OCR local + texto enviado ao Gemini
  LOCAL      // 100% no navegador (modo local ou fallback)
}

// Telemetria do renomeador: um evento por método dentro de cada rodada de
// ANÁLISE (registrado quando os arquivos são enviados para IA/OCR, não na
// renomeação final). Alimenta o resumo e a listagem de /admin.
// Privacidade: NENHUM nome de arquivo/pessoa é gravado — `itens` guarda só a
// TAG de tipo de cada documento e flags de download. Visível para MASTER.
model RenameEvent {
  id         String        @id @default(cuid())
  quantidade Int
  metodo     MetodoAnalise @default(LOCAL)
  // Onde o lote foi analisado. O Renomeador é embutido no cofre do
  // Sucessorista, então um lote pode nascer em qualquer um dos dois sites — o
  // evento conta para o painel da plataforma em que a pessoa estava.
  // null = registro anterior à separação.
  app        Plataforma?
  // Duração total do processamento daquele método na rodada, em ms.
  duracaoMs  Int?
  // Array<{ tipo: string; baixado?: boolean; otimizado?: boolean }>
  itens      Json?
  // { zip?: boolean; montagem?: { subpastas; converterPdf; numerar } } —
  // preenchido depois, quando o lote é baixado/aplicado.
  desfecho   Json?
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@map("rename_events")
}

// Telemetria do Resolvedor de Notas: um evento por TRIAGEM de nota
// devolutiva (o momento em que a nota é decomposta em exigências e cada uma
// é classificada numa via de resolução). Os desfechos de cada exigência
// (via corrigida à mão, minuta gerada, download) são gravados depois, por
// índice, como no renomeador.
// Privacidade: NADA do texto da nota, nomes de pessoa/arquivo, prenotação ou
// serventia — só as TAGS do vocabulário fechado do módulo e contagens.
model NotaEvent {
  id         String   @id @default(cuid())
  // Exigências detectadas na nota.
  quantidade Int
  // Fonte do texto: docx | pdf-nativo | pdf-escaneado | texto | imagem | outro
  fonte      String
  // true = texto colado/corrigido à mão (a leitura automática da pasta falhou).
  manual     Boolean  @default(false)
  // Arquivos indexados na pasta do caso (0 = trabalhou sem pasta).
  arquivos   Int      @default(0)
  duracaoPasta Int?
  duracaoMs  Int?
  // Array<{ via, alvos: string[], temGatilho, pessoas: number,
  //          viaFinal?, status?, peca?, comIa?, camposIa?, faltando?,
  //          baixouMinuta?, baixouJuntada?, achadosNaPasta? }>
  itens      Json?
  // { minutas?: number; downloads?: number; resolvidos?: number }
  desfecho   Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@map("notas_events")
}

// Ações medidas no Sucessorista (uma linha por ação relevante do caso).
enum AcaoSucessorista {
  LEITURA_COFRE // etapa 0: documentos lidos pela IA
  CALCULO       // espelho da partilha calculado (o caso "fechou")
  DOCUMENTO     // minuta/planilha/processo gerado
  PORTAL        // convite ao herdeiro gerado
}

// Telemetria do Sucessorista. Privacidade: nenhum nome de parte, CPF, nome de
// arquivo ou VALOR ABSOLUTO do acervo — o porte do caso entra como FAIXA
// (decisão explícita do dono do produto), o resto é contagem/tag/enum.
model SucessoristaEvent {
  id         String           @id @default(cuid())
  acao       AcaoSucessorista
  // Identificador aleatório do caso (crypto.randomUUID no cliente) — amarra os
  // eventos de um mesmo inventário SEM identificar ninguém. Permite contar
  // casos distintos e atualizar o retrato do caso em vez de duplicar linhas.
  casoId     String?
  // Perfil ativo na lombada: ADVOGADO | ESCREVENTE.
  perfil     String?
  // Documentos lidos, arquivos gerados, herdeiros do caso… (depende da ação).
  quantidade Int              @default(0)
  duracaoMs  Int?
  // Contexto estrutural: { herdeiros, bens, tiposBem[], regime, vinculo, rito,
  //   porte, temSobrevivente, incapaz, isencoes, progressivo, documento, tipos[] }
  dados      Json?
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([casoId, acao])
  @@map("sucessorista_events")
}
